# Chave da API da GroqCloud (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Opcional - modelo Groq a ser usado (padrao: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Opcional - observabilidade no LangSmith (https://smith.langchain.com)
# Sem essas variaveis o agente funciona normalmente, so nao aparece no LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=EndoAssist
